    {
        "id": "9d085773e54e4c2e",
        "type": "function",
        "z": "29709a6185aaadb5",
        "name": "Evaluar umbral",
        "func": "const UMBRAL = 35;\nconst COOLDOWN_MS = 10 * 60 * 1000; // 10 minutos\n\nconst estabaEnAlarma = context.get('enAlarma') || false;\nconst ultimoDisparo = context.get('ultimoDisparo') || 0;\nconst ahora = Date.now();\n\nconst enAlarmaAhora = msg.payload > UMBRAL;\n\n// Reset: si vuelve a la normalidad, se habilita para disparar de nuevo\nif (!enAlarmaAhora) {\n    context.set('enAlarma', false);\n    return null;\n}\n\n// Solo dispara si: cruza a alarma (flanco) Y no está en cooldown\nif (enAlarmaAhora && !estabaEnAlarma && (ahora - ultimoDisparo > COOLDOWN_MS)) {\n    context.set('enAlarma', true);\n    context.set('ultimoDisparo', ahora);\n\n    msg.headers = { \"Authorization\": \"Bearer TU_API_KEY_AQUI\" };\n    msg.payload = {\n        asset_id: \"esp32-dht11-01\",\n        alarm_type: \"temperatura_alta\",\n        value: msg.payload,\n        threshold: UMBRAL,\n        timestamp: new Date().toISOString(),\n        source: \"iot-lab\"\n    };\n    return msg;\n}\n\nreturn null; // ya estaba en alarma o en cooldown -> no repetir",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 640,
        "y": 180,
        "wires": [
